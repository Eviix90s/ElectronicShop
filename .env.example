# Copia este archivo a .env.local y rellena los valores.
# Sin estas variables la app corre en modo demostración (catálogo local, sin cuentas ni pedidos persistidos).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (para metadatos, sitemap y correos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mercado Pago (checkout real; opcional en esta fase)
MERCADOPAGO_ACCESS_TOKEN=

# Correo transaccional con Resend (opcional en esta fase)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
